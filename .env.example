# Configuración de Conexión a Supabase (PostgreSQL + Realtime)
# Obtén estos valores en tu consola de Supabase:
# Project Settings -> API -> Project URL y Project API Keys (anon public)

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# Configuración del Asistente Local con Ollama
VITE_OLLAMA_API_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2

