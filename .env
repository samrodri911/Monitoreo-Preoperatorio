# Configuración de Conexión a Supabase (PostgreSQL + Realtime)
# Dejar vacío o con valores por defecto para operar en Modo Demo Local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configuración del Asistente Local con Ollama
VITE_OLLAMA_API_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma3:4b

# Configuración del Microservicio de Voz Neuronal (Edge-TTS)
VITE_TTS_API_URL=http://localhost:8000/api/tts
